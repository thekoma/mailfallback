# MAILFALLBACK_DEBUG=true
MAILFALLBACK_SECRET_KEY=change-me-generate-a-random-string
MAILFALLBACK_SESSION_SECRET=change-me-generate-another-random-string

# Shared database credentials — used by all services in docker-compose.yml
# DB_USER=mailfallback
# DB_PASSWORD=mailfallback
# DB_NAME=mailfallback

# Database URL — PostgreSQL required. The docker-compose.yml sets this automatically.
# Override only if using an external PostgreSQL instance:
# MAILFALLBACK_DATABASE_URL=postgresql://user:pass@host:5432/mailfallback

# Google OAuth2 (optional — required for Gmail backup)
# MAILFALLBACK_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# MAILFALLBACK_GOOGLE_CLIENT_SECRET=your-client-secret

# Microsoft OAuth2 (optional — required for Outlook/Live/Hotmail backup)
# MAILFALLBACK_MICROSOFT_CLIENT_ID=your-app-id
# MAILFALLBACK_MICROSOFT_CLIENT_SECRET=your-client-secret
# MAILFALLBACK_MICROSOFT_TENANT=consumers

# OIDC/SSO (optional)
# MAILFALLBACK_OIDC_ENABLED=true
# MAILFALLBACK_OIDC_CLIENT_ID=
# MAILFALLBACK_OIDC_CLIENT_SECRET=
# MAILFALLBACK_OIDC_DISCOVERY_URL=https://sso.example.com/application/o/mailfallback/.well-known/openid-configuration
# MAILFALLBACK_OIDC_ADMIN_GROUP=admins

# Dovecot OAuth2 token validation (required for Roundcube SSO)
# DOVECOT_OAUTH2_USERINFO_URL=https://sso.example.com/application/o/userinfo/

# Webmail (optional — show "Webmail" link in nav bar)
# MAILFALLBACK_WEBMAIL_URL=http://localhost:8001

# Roundcube SSO via Authentik (optional — enables "Login with Authentik" button)
# Create a separate OAuth2 provider in Authentik for Roundcube.
# ROUNDCUBE_OAUTH_CLIENT_ID=
# ROUNDCUBE_OAUTH_CLIENT_SECRET=
# ROUNDCUBE_OAUTH_AUTH_URI=https://sso.example.com/application/o/authorize/
# ROUNDCUBE_OAUTH_TOKEN_URI=https://sso.example.com/application/o/token/
# ROUNDCUBE_OAUTH_IDENTITY_URI=https://sso.example.com/application/o/userinfo/
