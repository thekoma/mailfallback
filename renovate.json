{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/tests/**",
    "**/__fixtures__/**"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Vendored frontend assets pinned in vendor.json; files are re-downloaded by scripts/sync_vendor.py and CI blocks drift",
      "fileMatch": ["^src/mailfallback/static/vendor/vendor\\.json$"],
      "matchStrings": ["\"(?<depName>[^\"]+)\":\\s*\\{\\s*\"version\":\\s*\"(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "npm"
    }
  ]
}
